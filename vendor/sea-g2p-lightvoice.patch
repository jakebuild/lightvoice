@@ -0,0 +1,63 @@
+//! wasm-bindgen exports for running sea-g2p in a browser.
+//! Added for LightVoice (not part of upstream sea-g2p).
+//!
+//! The browser has no filesystem to mmap, so the host fetches `sea_g2p.bin`
+//! itself and hands the bytes to [`SeaG2p::new`]. The surface is the same two
+//! stages as `capi.rs` — normalize, then phonemize — plus the punctuation rule:
+//!
+//! ```bash
+//! cargo build --release --target wasm32-unknown-unknown --no-default-features --features wasm
+//! wasm-bindgen --target web --out-dir pkg target/wasm32-unknown-unknown/release/sea_g2p_rs.wasm
+//! ```
+
+use wasm_bindgen::prelude::*;
+
+use crate::core::dict::PhonemeDict;
+use crate::g2p::G2PEngine;
+use crate::lang::vi::Normalizer;
+
+#[wasm_bindgen]
+pub struct SeaG2p {
+    normalizer: Normalizer,
+    engine: G2PEngine,
+}
+
+#[wasm_bindgen]
+impl SeaG2p {
+    /// Build from the bytes of `sea_g2p.bin`. The normalizer and the G2P engine
+    /// share one copy of the dictionary.
+    #[wasm_bindgen(constructor)]
+    pub fn new(dict: Vec<u8>) -> Result<SeaG2p, JsError> {
+        let dict = PhonemeDict::from_bytes(dict).map_err(|e| JsError::new(&e.to_string()))?;
+        crate::lang::vi::technical::init_norm_dict_from(dict.clone());
+        Ok(SeaG2p { normalizer: Normalizer::new("vi", None), engine: G2PEngine::from_dict(dict) })
+    }
+
+    /// Vietnamese text → phonemes (normalize, then phonemize).
+    pub fn phonemize(&self, text: &str, punc_norm: bool) -> String {
+        if text.is_empty() {
+            return String::new();
+        }
+        let normalized = self.normalizer.normalize(text, punc_norm);
+        self.engine.phonemize(&normalized)
+    }
+
+    /// Normalization alone: numbers, dates, units and abbreviations become words.
+    pub fn normalize(&self, text: &str, punc_norm: bool) -> String {
+        if text.is_empty() {
+            return String::new();
+        }
+        self.normalizer.normalize(text, punc_norm)
+    }
+
+    /// Phonemize text that is already normalized.
+    pub fn phonemize_normalized(&self, text: &str) -> String {
+        self.engine.phonemize(text)
+    }
+}
+
+/// The trailing-punctuation rule as a pure string operation.
+#[wasm_bindgen]
+pub fn punc_norm(text: &str) -> String {
+    crate::punc::apply_punc_norm(text)
+}
